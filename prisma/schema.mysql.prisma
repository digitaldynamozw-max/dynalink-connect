// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-1.1.x", "debian-openssl-3.0.x", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id               String       @id @default(cuid())
  email            String       @unique
  name             String?
  password         String?
  role             String       @default("user")
  adminDepartment  String?
  isSupportAgent   Boolean      @default(false)
  isActive         Boolean      @default(true)
  mobileNumber     String?
  language         String       @default("en")
  accountBalance   Float        @default(0)
  profilePicture   String?
  deliveryAddress  String?
  customerZipCode  String?
  firstName        String?
  lastName         String?
  vehicleMake      String?
  vehicleModel     String?
  vehicleYear      Int?
  vehicleMileageKm Int?
  vehicleCapacityKg Int?
  vehiclePlateNumber String?
  
  // Vendor fields
  isVendor         Boolean      @default(false)
  vendorName       String?      @unique
  vendorDescription String?      @db.Text
  vendorImage      String?       @db.Text
  storeBannerImage String?       @db.Text
  vendorPriority   Int          @default(0)
  vendorCategory   String?
  storeAddress     String?
  storeCity        String?
  storeState       String?
  storeZipCode     String?
  latitude         Float?
  longitude        Float?
  vendorPhoneNumber String?
  vendorVerified   Boolean      @default(false)
  vendorJoinedAt   DateTime?
  commissionRate   Float        @default(10)
  weeklyOpeningHours String?     @db.Text
  temporarilyClosed Boolean     @default(false)
  notificationPreferencesJson String? @db.Text
  
  // Relations
  orders           Order[]
  ratings          Rating[]
  reviews          Review[]
  wishlistItems    WishlistItem[]
  promoCodes       PromoCode[]
  referralsCreated Referral[]   @relation("referrer")
  referralsReceived Referral[]  @relation("referred")
  supportTickets   SupportTicket[]
  products         Product[]
  payouts          VendorPayout[]
  deliveryZones    DeliveryZone[] @relation("vendorDeliveryZones")
  orderItems       OrderItem[]
  notifications    Notification[]
  pushSubscriptions PushSubscription[]
  paynowSweepRuns  PayNowSweepRun[]
  payNowReconciliationChecksTriggered PayNowReconciliationCheck[]
  walletTransactions WalletTransaction[]
  walletWithdrawalRequests WalletWithdrawalRequest[]
  auctionsForSale   Auction[]     @relation("AuctionSeller")
  wonAuctions       Auction[]     @relation("AuctionWinnerUser")
  auctionBids       AuctionBid[]  @relation("AuctionBidder")
  auctionClaims     AuctionClaim[] @relation("AuctionClaimWinner")
  auctionClaimsReviewed AuctionClaim[] @relation("AuctionClaimReviewedBy")
  auctionClaimsReleased AuctionClaim[] @relation("AuctionClaimReleasedBy")
  auctionDisputesOpened AuctionDispute[] @relation("AuctionDisputeOpenedBy")
  auctionDisputesResolved AuctionDispute[] @relation("AuctionDisputeResolvedBy")
  submittedChangeRequests SystemChangeRequest[] @relation("SystemChangeRequestedBy")
  reviewedChangeRequests SystemChangeRequest[] @relation("SystemChangeReviewedBy")
  
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
}

model Product {
  id          String     @id @default(cuid())
  name        String
  description String?  @db.Text
  price       Float
  salePrice   Float?
  onSale      Boolean    @default(false)
  image       String?  @db.Text
  category    String?
  stock       Int        @default(0)
  preparationTimeMinutes Int @default(0)
  salesCount  Int        @default(0)
  rating      Float      @default(0)
  averageRating Float    @default(0)
  reviewCount Int        @default(0)
  optionGroupsJson String? @db.LongText
  specificationsJson String? @db.LongText
  
  // Vendor relationship (optional for backward compatibility)
  vendorId    String?
  vendor      User?      @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  
  orderItems  OrderItem[]
  ratings     Rating[]
  reviews     Review[]
  wishlistItems WishlistItem[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  
  @@index([vendorId])
}


model Order {
    id        String      @id @default(cuid())
    orderNumber String?   @unique
    userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     OrderItem[]
  payNowReconciliationChecks PayNowReconciliationCheck[]
  total     Float
  status    String      @default("pending")
  payNowRef String?     @unique
  payNowPollUrl String? @db.Text
  payNowBrowserUrl String? @db.Text
  payNowExternalReference String?
  
    // Delivery tracking
    deliveryAddress String?
    deliveryFee Float     @default(0)
    platformFee Float     @default(1)
    promoCode String?
    promoDiscount Float   @default(0)
    fulfillmentMethod String @default("delivery")
    requestedDeliveryAt DateTime?
  
    createdAt DateTime    @default(now())
    updatedAt DateTime    @updatedAt

    @@index([promoCode])
  }

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])
  vendorId  String?
  vendor    User?   @relation(fields: [vendorId], references: [id])
  payoutId  String?
  payout    VendorPayout? @relation(fields: [payoutId], references: [id], onDelete: SetNull)
  quantity  Int
  price     Float
  selectedOptionsJson String? @db.LongText
  selectedOptionsSummary String? @db.Text
  status    String  @default("pending")
  preparationMinutes Int @default(0)
  additionalDelayMinutes Int @default(0)
  estimatedDeliveryMinutes Int?
  deliveryFee Float @default(0)
  vendorEarnings Float @default(0)
  proofPhotoDataUrl String?
  proofSignatureName String?
  proofChecklistJson String?
  proofSubmittedAt DateTime?
  proofAuditNote String?
  updatedAt DateTime @updatedAt
  
  @@index([orderId])
  @@index([status])
  @@index([vendorId])
  @@index([payoutId])
}

model Rating {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  rating    Int      @default(5)
  comment   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, productId])
}

model Review {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  rating    Int      // 1-5 stars
  title     String
  comment   String
  helpful   Int      @default(0)
  notHelpful Int     @default(0)
  verified  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, productId])
}

model WishlistItem {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  addedAt   DateTime @default(now())

  @@unique([userId, productId])
}
model PromoCode {
    id          String   @id @default(cuid())
    code        String   @unique
    discountType String  @default("cart")
    discount    Float
    description String?
  expiryDate  DateTime
  maxUses     Int      @default(1)
  currentUses Int      @default(0)
  minPurchase Float    @default(0)
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Referral {
  id            String   @id @default(cuid())
  referrerId    String
  referrer      User     @relation("referrer", fields: [referrerId], references: [id], onDelete: Cascade)
  referredId    String
  referred      User     @relation("referred", fields: [referredId], references: [id], onDelete: Cascade)
  rewardAmount  Float    @default(25)
  status        String   @default("pending")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model SupportTicket {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject   String
  message   String
  status    String   @default("open")
  priority  String   @default("normal")
  response  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model DeliveryZone {
  id        String  @id @default(cuid())
  vendorId  String
  vendor    User    @relation("vendorDeliveryZones", fields: [vendorId], references: [id], onDelete: Cascade)
  zipCode   String
  city      String?
  state     String?
  address   String?
  baseFee   Float
  perKmFee  Float   @default(0)
  maxDistance Float @default(50)
  active    Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@unique([vendorId, zipCode])
  @@index([vendorId])
}

model VendorPayout {
  id        String  @id @default(cuid())
  vendorId  String
  vendor    User    @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  items     OrderItem[]
  amount    Float
  status    String  @default("requested")
  ordersIncluded Int @default(0)
  paymentMethod String?
  transactionId String?
  reviewedAt DateTime?
  reviewedById String?
  reviewNotes String?
  processedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@index([vendorId])
}

model Notification {
  id          String   @id @default(cuid())
  recipientId String?
  recipient   User?    @relation(fields: [recipientId], references: [id], onDelete: Cascade)
  audience    String   @default("user")
  channel     String   @default("in_app")
  title       String
  message     String   @db.Text
  orderId     String?
  orderItemId String?
  statusFrom  String?
  statusTo    String?
  deliveryStatus String?
  metadata    String?
  externalMessageId String?
  read        Boolean  @default(false)
  sentAt      DateTime?
  failedAt    DateTime?
  createdAt   DateTime @default(now())

  @@index([recipientId])
  @@index([audience])
  @@index([channel])
  @@index([deliveryStatus])
  @@index([orderItemId, audience])
  @@index([createdAt])
}

model PushSubscription {
  id               String   @id @default(cuid())
  endpoint         String   @unique
  p256dh           String
  auth             String
  userId           String?
  user             User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  visitorId        String?  @db.VarChar(191)
  audience         String   @default("all")
  userAgent        String?  @db.Text
  lastKnownPath    String?  @db.Text
  isActive         Boolean  @default(true)
  lastSeenAt       DateTime @default(now())
  lastSentAt       DateTime?
  lastErrorAt      DateTime?
  lastErrorMessage String?  @db.Text
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([userId])
  @@index([visitorId])
  @@index([audience])
  @@index([isActive, lastSeenAt])
}

model RegistrationVerification {
  id           String   @id @default(cuid())
  email        String   @unique
  mobileNumber String?
  name         String
  passwordHash String   @db.Text
  channel      String
  codeHash     String   @db.Text
  attempts     Int      @default(0)
  expiresAt    DateTime
  lastSentAt   DateTime @default(now())
  verifiedAt   DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([expiresAt])
}

model SiteSettings {
  id                   String   @id
  companyName          String   @default("DynaLink Connect")
  heroBadge            String   @default("Company Marketplace")
  heroTitle            String   @default("Welcome to DynaLink Connect")
  heroSubtitle         String   @default("Fast, reliable delivery from your favorite vendors. Shop everything you need in one place.")
  heroBackgroundImage  String?  @db.Text
  heroForegroundImage  String?  @db.Text
  primaryCtaLabel      String   @default("Shop Now")
  primaryCtaHref       String   @default("/products")
  secondaryCtaLabel    String   @default("Become a Vendor")
  secondaryCtaHref     String   @default("/vendor/register")
  whatsappNumber       String   @default("+263788006331")
  referralEnabled      Boolean  @default(true)
  referralRewardAmount Float    @default(25)
  referralHeadline     String   @default("Referral program is active")
  platformOrdersPaused Boolean  @default(false)
  allStoresTemporarilyClosed Boolean @default(false)
  pickupEnabled        Boolean  @default(true)
  paynowGatewayEnabled Boolean  @default(true)
  ecocashGatewayEnabled Boolean @default(true)
  onemoneyGatewayEnabled Boolean @default(true)
  walletGatewayEnabled Boolean @default(true)
  offlinePaymentEnabled Boolean @default(true)
  payOnDeliveryEnabled Boolean  @default(false)
  allowMultiVendorWithinRadius Boolean @default(false)
  registrationOtpEnabled Boolean @default(true)
  userChangeApprovalEnabled Boolean @default(false)
  vendorChangeApprovalEnabled Boolean @default(false)
    vendorStorePreviewEnabled Boolean @default(true)
    vendorWorkspaceRestricted Boolean @default(true)
    platformFeePerOrder  Float    @default(1)
    globalDeliveryEtaMinutes Int  @default(120)
    customerOrderCancellationWindowMinutes Int @default(1)
    googleMapsEmbedUrl   String?  @db.Text
  customerAuthFaqJson   String?  @db.LongText
  customerSupportFaqJson String? @db.LongText
  platformStoreAddress String?  @default("DynaLink Connect") @db.Text
  updatedAt            DateTime @updatedAt
  createdAt            DateTime @default(now())
}

model SystemChangeRequest {
  id                String   @id @default(cuid())
  requestedByUserId String
  requestedByUser   User     @relation("SystemChangeRequestedBy", fields: [requestedByUserId], references: [id], onDelete: Cascade)
  reviewedByUserId  String?
  reviewedByUser    User?    @relation("SystemChangeReviewedBy", fields: [reviewedByUserId], references: [id], onDelete: SetNull)
  changeArea        String
  changeType        String
  payloadJson       String   @db.LongText
  status            String   @default("pending")
  summary           String?  @db.VarChar(191)
  adminNotes        String?  @db.LongText
  reviewedAt        DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([requestedByUserId, status])
  @@index([status, createdAt])
}

model PayNowSweepRun {
  id               String   @id @default(cuid())
  triggerSource    String
  triggeredByUserId String?
  triggeredByUser  User?    @relation(fields: [triggeredByUserId], references: [id], onDelete: SetNull)
  limit            Int
  maxAgeHours      Int
  scannedCount     Int      @default(0)
  reconciledCount  Int      @default(0)
  alreadyPaidCount Int      @default(0)
  stillPendingCount Int     @default(0)
  failedCount      Int      @default(0)
  notes            String?  @db.Text
  createdAt        DateTime @default(now())

  @@index([createdAt])
  @@index([triggerSource])
  @@index([triggeredByUserId])
}

model PayNowReconciliationCheck {
  id                 String   @id @default(cuid())
  orderId            String
  order              Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  triggerSource      String
  triggeredByUserId  String?
  triggeredByUser    User?    @relation(fields: [triggeredByUserId], references: [id], onDelete: SetNull)
  success            Boolean  @default(false)
  reconciled         Boolean  @default(false)
  alreadyPaid        Boolean  @default(false)
  orderStatus        String
  providerStatus     String?
  error              String?  @db.Text
  checkedAt          DateTime @default(now())

  @@index([orderId, checkedAt])
  @@index([triggerSource])
  @@index([triggeredByUserId])
}

model WalletTransaction {
  id                    String   @id @default(cuid())
  userId                String
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type                  String
  status                String   @default("pending")
  amount                Float
  balanceBefore         Float
  balanceAfter          Float
  reference             String?  @unique
  description           String?  @db.Text
  orderId               String?
  payNowPollUrl         String?  @db.Text
  payNowBrowserUrl      String?  @db.Text
  payNowExternalReference String?
  metadata              String?  @db.LongText
  processedAt           DateTime?
  createdAt             DateTime @default(now())

  @@index([userId, createdAt])
  @@index([status])
  @@index([type])
}

model WalletWithdrawalRequest {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount      Float
  status      String   @default("pending")
  mobileNumber String?
  note        String?  @db.Text
  reviewNotes String?  @db.Text
  processedAt DateTime?
  createdAt   DateTime @default(now())

  @@index([userId, createdAt])
  @@index([status])
}

model Auction {
  id              String      @id @default(cuid())
  sellerId        String
  seller          User        @relation("AuctionSeller", fields: [sellerId], references: [id], onDelete: Cascade)
  title           String
  description     String?
  category        String?
  image           String?
  startingPrice   Float
  reservePrice    Float?
  buyNowPrice     Float?
  minBidIncrement Float       @default(1)
  currentPrice    Float       @default(0)
  status          String      @default("draft")
  startsAt        DateTime
  endsAt          DateTime
  winnerBidId     String?     @unique
  winnerBid       AuctionBid? @relation("AuctionWinner", fields: [winnerBidId], references: [id], onDelete: SetNull)
  winnerUserId    String?
  winnerUser      User?       @relation("AuctionWinnerUser", fields: [winnerUserId], references: [id], onDelete: SetNull)
  bids            AuctionBid[]
  claim           AuctionClaim?
  disputes        AuctionDispute[]
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([sellerId, status, startsAt])
  @@index([status, endsAt])
}

model AuctionBid {
  id         String    @id @default(cuid())
  auctionId  String
  auction    Auction   @relation(fields: [auctionId], references: [id], onDelete: Cascade)
  bidderId   String
  bidder     User      @relation("AuctionBidder", fields: [bidderId], references: [id], onDelete: Cascade)
  amount     Float
  isWinning  Boolean   @default(false)
  createdAt  DateTime  @default(now())
  wonAuction Auction?  @relation("AuctionWinner")

  @@index([auctionId, amount, createdAt])
  @@index([bidderId, createdAt])
}

model AuctionClaim {
  id           String   @id @default(cuid())
  auctionId    String   @unique
  auction      Auction  @relation(fields: [auctionId], references: [id], onDelete: Cascade)
  winnerUserId String
  winnerUser   User     @relation("AuctionClaimWinner", fields: [winnerUserId], references: [id], onDelete: Cascade)
  amount       Float
  status       String   @default("pending")
  paymentMethod String?
  walletTransactionId String?
  reviewNote   String?
  reviewedByUserId String?
  reviewedByUser User? @relation("AuctionClaimReviewedBy", fields: [reviewedByUserId], references: [id], onDelete: SetNull)
  releasedByUserId String?
  releasedByUser User? @relation("AuctionClaimReleasedBy", fields: [releasedByUserId], references: [id], onDelete: SetNull)
  releasedAt   DateTime?
  releaseAmount Float?
  paidAt       DateTime?
  fulfilledAt  DateTime?
  disputes     AuctionDispute[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([winnerUserId, status, createdAt])
  @@index([status, createdAt])
  @@index([reviewedByUserId])
  @@index([releasedByUserId])
}

model AuctionDispute {
  id             String   @id @default(cuid())
  auctionId      String
  auction        Auction  @relation(fields: [auctionId], references: [id], onDelete: Cascade)
  claimId        String?
  claim          AuctionClaim? @relation(fields: [claimId], references: [id], onDelete: SetNull)
  openedByUserId String
  openedByUser   User     @relation("AuctionDisputeOpenedBy", fields: [openedByUserId], references: [id], onDelete: Cascade)
  resolvedByUserId String?
  resolvedByUser User?    @relation("AuctionDisputeResolvedBy", fields: [resolvedByUserId], references: [id], onDelete: SetNull)
  status         String   @default("open")
  reason         String
  details        String?
  resolutionNote String?
  openedAt       DateTime @default(now())
  resolvedAt     DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([auctionId, status, createdAt])
  @@index([openedByUserId, createdAt])
  @@index([resolvedByUserId])
  @@index([claimId])
}
