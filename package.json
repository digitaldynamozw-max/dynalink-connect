{
  "name": "dynalink_connect",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/prisma-cli.cjs generate",
    "dev": "next dev -H 0.0.0.0 -p 3001",
    "mobile:start": "npm --prefix apps/mobile start",
    "mobile:start:customer": "npm --prefix apps/mobile run start:customer",
    "mobile:start:driver": "npm --prefix apps/mobile run start:driver",
    "mobile:start:vendor": "npm --prefix apps/mobile run start:vendor",
    "mobile:android": "npm --prefix apps/mobile run android",
    "mobile:android:customer": "npm --prefix apps/mobile run android:customer",
    "mobile:android:driver": "npm --prefix apps/mobile run android:driver",
    "mobile:android:vendor": "npm --prefix apps/mobile run android:vendor",
    "mobile:ios": "npm --prefix apps/mobile run ios",
    "mobile:ios:customer": "npm --prefix apps/mobile run ios:customer",
    "mobile:ios:driver": "npm --prefix apps/mobile run ios:driver",
    "mobile:ios:vendor": "npm --prefix apps/mobile run ios:vendor",
    "mobile:install": "npm --prefix apps/mobile install",
    "mobile:eas:whoami": "npm --prefix apps/mobile run eas:whoami",
    "mobile:eas:ios:credentials": "npm --prefix apps/mobile run eas:ios:credentials",
    "mobile:eas:ios:customer:credentials": "npm --prefix apps/mobile run eas:ios:customer:credentials",
    "mobile:eas:ios:driver:credentials": "npm --prefix apps/mobile run eas:ios:driver:credentials",
    "mobile:eas:ios:vendor:credentials": "npm --prefix apps/mobile run eas:ios:vendor:credentials",
    "mobile:eas:ios:device": "npm --prefix apps/mobile run eas:ios:device",
    "mobile:eas:ios:dev": "npm --prefix apps/mobile run eas:ios:dev",
    "mobile:eas:ios:simulator": "npm --prefix apps/mobile run eas:ios:simulator",
    "mobile:eas:ios:preview": "npm --prefix apps/mobile run eas:ios:preview",
    "mobile:eas:ios:production": "npm --prefix apps/mobile run eas:ios:production",
    "mobile:eas:ios:customer:preview": "npm --prefix apps/mobile run eas:ios:customer:preview",
    "mobile:eas:ios:customer:production": "npm --prefix apps/mobile run eas:ios:customer:production",
    "mobile:eas:ios:driver:preview": "npm --prefix apps/mobile run eas:ios:driver:preview",
    "mobile:eas:ios:driver:production": "npm --prefix apps/mobile run eas:ios:driver:production",
    "mobile:eas:ios:vendor:preview": "npm --prefix apps/mobile run eas:ios:vendor:preview",
    "mobile:eas:ios:vendor:production": "npm --prefix apps/mobile run eas:ios:vendor:production",
    "mobile:android:release:apk": "npm --prefix apps/mobile run android:release:apk",
    "mobile:android:release:aab": "npm --prefix apps/mobile run android:release:aab",
    "mobile:android:release:customer:apk": "npm --prefix apps/mobile run android:release:customer:apk",
    "mobile:android:release:customer:aab": "npm --prefix apps/mobile run android:release:customer:aab",
    "mobile:android:release:driver:apk": "npm --prefix apps/mobile run android:release:driver:apk",
    "mobile:android:release:driver:aab": "npm --prefix apps/mobile run android:release:driver:aab",
    "mobile:android:release:vendor:apk": "npm --prefix apps/mobile run android:release:vendor:apk",
    "mobile:android:release:vendor:aab": "npm --prefix apps/mobile run android:release:vendor:aab",
    "mobile:eas:android:preview": "npm --prefix apps/mobile run eas:android:preview",
    "mobile:eas:android:production": "npm --prefix apps/mobile run eas:android:production",
    "mobile:eas:android:customer:preview": "npm --prefix apps/mobile run eas:android:customer:preview",
    "mobile:eas:android:customer:production": "npm --prefix apps/mobile run eas:android:customer:production",
    "mobile:eas:android:driver:preview": "npm --prefix apps/mobile run eas:android:driver:preview",
    "mobile:eas:android:driver:production": "npm --prefix apps/mobile run eas:android:driver:production",
    "mobile:eas:android:vendor:preview": "npm --prefix apps/mobile run eas:android:vendor:preview",
    "mobile:eas:android:vendor:production": "npm --prefix apps/mobile run eas:android:vendor:production",
    "build": "node scripts/prisma-cli.cjs generate && next build",
    "start:next": "next start",
    "package:cpanel": "powershell -ExecutionPolicy Bypass -File scripts/package-cpanel.ps1",
    "package:cpanel:passenger": "powershell -ExecutionPolicy Bypass -File scripts/package-cpanel-passenger.ps1",
    "lint": "eslint",
    "db:migrate": "node scripts/prisma-cli.cjs migrate dev",
    "db:generate": "node scripts/prisma-cli.cjs generate",
    "db:push": "node scripts/prisma-cli.cjs db push",
    "db:generate:mysql": "node scripts/prisma-cli.cjs --env=base generate --schema prisma/schema.mysql.prisma",
    "db:push:mysql": "node scripts/prisma-cli.cjs --env=base db push --schema prisma/schema.mysql.prisma",
    "db:backfill:faq": "node scripts/run-tsx-with-env.cjs scripts/backfill-site-settings-faq.ts",
    "db:backfill:faq:mysql": "node scripts/prisma-cli.cjs --env=base db execute --schema prisma/schema.mysql.prisma --file scripts/backfill-site-settings-faq.mysql.sql",
    "db:seed": "node scripts/run-tsx-with-env.cjs prisma/seed.ts",
    "reconcile:vendor-balances": "tsx scripts/reconcile-vendor-balances.ts",
    "reconcile:vendor-balances:apply": "tsx scripts/reconcile-vendor-balances.ts --apply",
    "repair:pickup-addresses": "tsx scripts/repair-pickup-order-addresses.ts",
    "repair:pickup-addresses:apply": "tsx scripts/repair-pickup-order-addresses.ts --apply",
    "verify:delivery": "tsx scripts/verify-delivery-operations.ts",
    "verify:production": "tsx scripts/production-readiness.ts",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.1",
    "@hookform/resolvers": "^5.2.2",
    "@prisma/client": "^5.22.0",
    "@types/bcryptjs": "^2.4.6",
    "bcryptjs": "^3.0.3",
    "lucide-react": "^0.577.0",
    "next": "16.1.7",
    "next-auth": "^4.24.13",
    "nodemailer": "^7.0.13",
    "prisma": "^5.22.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hook-form": "^7.71.2",
    "web-push": "^3.6.7",
    "zod": "^4.3.6",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@playwright/test": "^1.51.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/nodemailer": "^6.4.17",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "eslint": "^9",
    "eslint-config-next": "16.1.7",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
